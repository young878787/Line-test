              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "url": "http://127.0.0.1:5682/ingress",
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 100,
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "QfBL2OVotmdDCjuI",
          "name": "LINE n8n Internal"
        }
      }
    },
    {
