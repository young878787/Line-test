# ============================================
# 台北天氣預報 LINE Bot — 環境變數範本
# 複製此檔案為 .env 並填入實際金鑰
# ============================================

# 中央氣象署 API 授權碼
# 申請：https://opendata.cwa.gov.tw/index
CWA_API_KEY=CWA-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# LINE Bot Messaging API
# 設定：https://developers.line.biz/
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_MONTHLY_LIMIT=200
DATABASE_PATH=bot.sqlite3
LOCAL_TUNNEL_ENABLED=true

# 本地 vLLM（OpenAI 相容 API；thinking 固定關閉）
AI_API_Keys=
AI_API_URL=
AI_MODEL=
